# ==============================================================================
# AI Outreach Engine — Environment Configuration
# Copy this file to .env and populate your credentials:
#   cp config/env.example .env
# Or run the interactive setup wizard:
#   python setup.py
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM Provider (Groq or OpenRouter)
# ------------------------------------------------------------------------------
# Get a FREE Groq key (14,400 requests/day, 0.8s latency): https://console.groq.com/keys
GROQ_API_KEY=""

# (Optional) OpenRouter API key: https://openrouter.ai/keys
OPENROUTER_API_KEY=""

# Mode: "AUTO" (tries OpenRouter then Groq), "GROQ" (fastest, recommended), or "OPENROUTER"
LLM_PROVIDER="AUTO"

# ------------------------------------------------------------------------------
# 2. Notion CRM Connection
# ------------------------------------------------------------------------------
# Create an internal integration token at: https://www.notion.so/my-integrations
NOTION_TOKEN=""

# The 32-character database ID from your Notion database URL:
# https://www.notion.so/workspace/{DATABASE_ID}?v=...
NOTION_DATABASE_ID=""

# ------------------------------------------------------------------------------
# 3. Email Dispatcher (Gmail SMTP / Drafts)
# ------------------------------------------------------------------------------
# Your Gmail address
GMAIL_USER="your.email@gmail.com"

# 16-character App Password (NOT your standard account password):
# Generate at: Google Account -> Security -> 2-Step Verification -> App Passwords
GMAIL_APP_PASSWORD=""

# Dispatch Mode:
# - "GMAIL_DRAFT": Creates drafts in your Gmail Drafts folder for review (Recommended)
# - "AUTO_SEND": Dispatches live emails via SMTP with 15s spam-prevention throttle
DISPATCH_MODE="GMAIL_DRAFT"

# ------------------------------------------------------------------------------
# 4. Search & Lead Enrichment (Optional but Recommended)
# ------------------------------------------------------------------------------
# Get 2,500 FREE Google Searches to find company contact emails: https://serper.dev
SERPER_API_KEY=""

# (Optional) Apollo API Key for B2B company domain lookup: https://apollo.io
APOLLO_API_KEY=""

# ------------------------------------------------------------------------------
# 5. Pipeline Run Settings
# ------------------------------------------------------------------------------
# Default target qualified applications to complete per run (5-10 recommended)
TARGET_QUALIFIED=6

# Maximum raw leads to scan before safety pause
MAX_SCANS=50

# Minimum fit score threshold (0-100) to qualify for outreach
MIN_MATCH_SCORE=65

# Sourcing mode: "all" (both), "remote-jobs" (job boards), or "funded-startups" (VC funding)
OUTREACH_MODE="all"

# Candidate Profile Links (Overrides values in config/profile.json if set)
RESUME_DRIVE_URL=""
PORTFOLIO_URL=""
GITHUB_URL=""
LINKEDIN_URL=""
